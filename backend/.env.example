APP_NAME=Project Name

# SQLite needs no server/setup — the .db file is created automatically on first run.
DATABASE_URL=sqlite:///./airline.db

SECRET_KEY=supersecretkey
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: SMTP / Email settings (used for cancellations/refund notifications).
# Leave blank to disable email sending (the app runs fine without it).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=1
EMAIL_FROM=

# Example using SMTPS (SSL, port 465):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_SSL=1
# EMAIL_FROM=your-email@example.com

# Example using STARTTLS (port 587)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-smtp-password-or-app-password
# SMTP_USE_SSL=0
# EMAIL_FROM=your-email@example.com
# Optional: Frontend URL used for password reset links
FRONTEND_URL=http://localhost:3000
# Notes:
# - For Gmail use an App Password (requires 2FA). Use SMTP_HOST=smtp.gmail.com.
# - After adding these variables, restart the backend server (uvicorn) so the new settings are picked up.
